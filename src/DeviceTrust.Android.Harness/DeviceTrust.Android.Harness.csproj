<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DeviceTrust.Android.Harness</RootNamespace>
    <!-- Distinct from the Flutter reference client's com.example.devicefingerprinting.
         Android keys an install by package name, so a collision would replace that
         app and destroy its AndroidKeyStore entries on a shared test handset. -->
    <ApplicationId>com.example.devicefingerprinting_dotnet</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <!-- The battery is defined for release builds only: a debuggable APK scores
         android_app_debuggable +35 and would never reach the clean baseline. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- The docs comment in the SDK's code-integrity probe explains why this
         matters: with extractNativeLibs off, the app's native code maps straight
         out of base.apk and the app bucket must accept an .apk backing file.
         Extracting them instead gives the bucket real .so files to compare, which
         is the clearer arrangement for a test harness. -->
    <AndroidUseLegacyPackaging>true</AndroidUseLegacyPackaging>
  </PropertyGroup>

  <!-- Battery item 14 only. Building with -p:HookTest=true embeds a real Frida
       Gadget, RENAMED to libhelper.so and listening on 27999 rather than the
       default 27042. That is deliberate: item 14 is about detecting an inline
       hook by BEHAVIOUR (bytes in memory differing from bytes on disk), so
       the name-based probes must be blind for the result to mean anything.
       DESIGN.md 27.11 records exactly this evasion scoring 18/trusted against
       name matching while the gadget was fully active.
       Without the flag none of this is in the APK: a harness that shipped a
       gadget would be a liability, and the clean build is what every other
       item runs against. -->
  <PropertyGroup Condition="'$(HookTest)' == 'true'">
    <DefineConstants>$(DefineConstants);HOOKTEST</DefineConstants>
  </PropertyGroup>

  <!-- The gadget lives OUTSIDE the project directory and is passed in by path.
       The .NET Android SDK auto-globs **/*.so into AndroidNativeLibrary, so a
       copy anywhere under the project is packaged whatever any Condition says:
       a "clean" build silently shipped the 25 MB gadget that way once. Keeping
       it out of the tree makes that impossible rather than merely discouraged. -->
  <ItemGroup Condition="'$(HookTest)' == 'true' AND '$(HookTestGadgetDir)' != ''">
    <AndroidNativeLibrary Include="$(HookTestGadgetDir)\libhelper.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(HookTestGadgetDir)\libhelper.config.so" Abi="arm64-v8a" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceTrust.Client\DeviceTrust.Client.csproj" />
    <ProjectReference Include="..\DeviceTrust.Client.Maui\DeviceTrust.Client.Maui.csproj" />
  </ItemGroup>

</Project>
