<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Only the android and ios workloads are needed, not MAUI itself: the key
         stores and collectors are plain platform bindings, so they drop into a
         MAUI app, a .NET for Android app or a .NET for iOS app equally.
         Build with:  dotnet workload install android    (plus ios, on macOS) -->
    <!-- iOS can only be built on macOS: the ios workload does not install on
         Linux or Windows, because the build needs Xcode. Android builds
         anywhere, so a Linux or Windows CI still compiles that half. -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net8.0-android;net8.0-ios</TargetFrameworks>
    <AssemblyName>DeviceTrust.Client.Maui</AssemblyName>
    <RootNamespace>DeviceTrust.Client.Maui</RootNamespace>
    <PackageId>DeviceTrust.Client.Maui</PackageId>
    <Description>AndroidKeyStore and iOS Secure Enclave installation keys, plus the native integrity probe sets, for the Device Trust client SDK.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <!-- 15.0, not 13.0. The reference session measured the real floor: the
         toolchain's own minimum lands here, and the test iPhone 7 runs 15.8.5,
         so 13.0 was aspirational rather than tested. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceTrust.Client\DeviceTrust.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <Compile Remove="Android\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
    <Compile Remove="Apple\**\*.cs" />
  </ItemGroup>

</Project>
