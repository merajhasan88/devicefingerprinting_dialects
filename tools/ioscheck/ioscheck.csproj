<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-checks the iOS sources on Linux, against Apple's real bindings.

    Why this exists. src/DeviceTrust.Client.Maui/Apple/*.cs can only be built
    for net9.0-ios, and the ios workload cannot install anywhere but macOS, so
    on a Linux or Windows machine those files are never compiled by anything:
    the csproj excludes them from the android target. They sat unverified for
    weeks as a result, and when this project was first run it found four real
    defects in the Secure Enclave key store that no amount of reading had
    caught: SecAccessControl has a constructor rather than a static Create, and
    SecKeyChain.QueryAsReference returns an INativeObject ARRAY and requires an
    explicit maximum, so a two-argument call silently bound the status variable
    to the count parameter.

    A hand-written stub would have found none of those, because a stub encodes
    the author's belief about the API, which is exactly the thing being
    checked. This references the genuine Microsoft.iOS reference assembly.

    Not in DeviceTrust.sln on purpose: it downloads a ~51 MB reference pack, so
    it should be run deliberately rather than on every build.

        dotnet build tools/ioscheck

    The pack is chosen to match what the Codemagic build resolves: .NET 9 with
    the iOS 26 bindings, which is the newest binding family that exists for a
    runtime this machine can compile against. A net10.0 reference assembly is
    not usable here, because a net9.0 compilation that references one fails with
    CS1705, and CS1705 is an error rather than a warning that could be waived.
    Override IosRefPackage and IosRefVersion to re-check against another family:
        dotnet build tools/ioscheck -p:IosRefPackage=Microsoft.iOS.Ref.net9.0_18.0 \
                                    -p:IosRefVersion=18.0.9617
    Limits worth knowing, each one paid for by a failed Codemagic build.

    A reference assembly proves the API surface compiles; it does not run the ios
    workload, link against a real Xcode SDK or produce a bundle.

    The platform analysers are inert here. CA1416 and CA1422 need a platform in
    the target framework, and this one is plain net9.0; setting
    [assembly: SupportedOSPlatform] does not wake them, which was tried. So a
    call to an API Apple has obsoleted on a newer iOS passes here and fails the
    real build, as `new UIWindow(CGRect)` did. tools/obsscan reads the same
    obsoletion metadata directly and answers the same question; docs/validation.md
    carries the command, which cannot be written in this file because a double
    hyphen is not legal inside an XML comment.

    CS8765, a parameter whose nullability disagrees with the member it overrides,
    is not reported here either, though the file IS compiled and the same
    reference assembly is used. There are three overrides in the iOS sources;
    when adding a fourth, check its signature against the binding by hand.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The platform analyzer cannot help here: this is a plain net9.0 project
         standing in for net9.0-ios, so every iOS API would be "unsupported". -->
    <NoWarn>$(NoWarn);CA1416;CS0618;CS8632;CS1591</NoWarn>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages</RestorePackagesPath>
    <IsPackable>false</IsPackable>
    <IosRefPackage Condition="'$(IosRefPackage)' == ''">Microsoft.iOS.Ref.net9.0_26.0</IosRefPackage>
    <IosRefVersion Condition="'$(IosRefVersion)' == ''">26.0.9785</IosRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="$(IosRefPackage)" Version="[$(IosRefVersion)]" />
    <Compile Include="../../src/DeviceTrust.Client.Maui/Apple/*.cs" />
    <Compile Include="../../src/DeviceTrust.iOS.Harness/*.cs" />
    <ProjectReference Include="../../src/DeviceTrust.Client/DeviceTrust.Client.csproj" />
    <Reference Include="Microsoft.iOS">
      <HintPath>$(MSBuildThisFileDirectory)packages/$(IosRefPackage.ToLowerInvariant())/$(IosRefVersion)/ref/net9.0/Microsoft.iOS.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
